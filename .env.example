# ==============================================================================
# AnimeYT — Environment Configuration Example
# ==============================================================================

# MongoDB Connection String (Source of truth for catalogue, versions, and verified episodes)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/animeyt?retryWrites=true&w=majority
MONGODB_URI=

# YouTube Data API v3 Key (Required for discovering candidates from official channels and playlists)
# Obtain from Google Cloud Console (APIs & Services > Credentials > YouTube Data API v3)
YOUTUBE_API_KEY=

# Administrator Secret Key (Secures protected import, candidate review, and verification routes)
# Defaults to "animeyt-admin-dev-key" in local development if omitted
ADMIN_SECRET_KEY=animeyt-admin-dev-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AniList Import Configuration Defaults for CLI script (npm run import:anilist)
# IMPORT_PAGES=2
# IMPORT_PER_PAGE=25
# IMPORT_SEARCH=

# Optional YouTube Discovery Configuration Defaults for CLI script (npm run discover:youtube)
# DISCOVER_QUERY=Demon Slayer Episode 1
# DISCOVER_SLUG=demon-slayer
