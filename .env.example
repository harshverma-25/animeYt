# ==============================================================================
# AnimeYT — Environment Configuration Example
# ==============================================================================

# MongoDB Connection String (Optional for development; falls back to verified in-memory store)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/animeyt?retryWrites=true&w=majority
MONGODB_URI=

# YouTube Data API v3 Key (Optional for browsing; required for importing new YouTube playlists/channels)
# Get your API key from the Google Cloud Console (APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Administrator Secret Key (Used to secure /admin portal, video verification, and seed routes)
# Defaults to "animeyt-admin-dev-key" in local development if left blank
ADMIN_SECRET_KEY=animeyt-admin-dev-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
